# Copy to .env (gitignored) and fill in. Used only when config.json does not exist.
# Load into your shell with:  set -a && . ./.env && set +a
JENKINS_URL=http://localhost:8080
JENKINS_USERNAME=<your-jenkins-username>
JENKINS_API_TOKEN=<your-jenkins-api-token>
AZURE_STORAGE_CONNECTION_STRING=<your-storage-account-connection-string>
AZURE_CONTAINER_NAME=jenkins-build-logs
